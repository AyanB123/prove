{
  "name": "prove",
  "displayName": "Prove",
  "description": "Evidence-gated control plane for coding agents. Mission status, sealed receipts, and prove verify — don't trust the agent, trust the evidence.",
  "version": "0.3.2",
  "publisher": "ayanb123",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Testing", "Other", "Linters"],
  "keywords": [
    "prove",
    "agents",
    "ai",
    "verification",
    "cli",
    "evidence",
    "coding-agents",
    "security",
    "receipts"
  ],
  "galleryBanner": {
    "color": "#1b1f33",
    "theme": "dark"
  },
  "icon": "media/icon.png",
  "activationEvents": [
    "workspaceContains:.prove/**",
    "onView:prove.mission",
    "onCommand:prove.status",
    "onCommand:prove.verify",
    "onCommand:prove.doctor",
    "onCommand:prove.openPolicy",
    "onCommand:prove.refresh",
    "onCommand:prove.init",
    "onCommand:prove.openReceipt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "prove.status", "title": "Prove: Status", "category": "Prove", "icon": "$(shield)" },
      { "command": "prove.verify", "title": "Prove: Verify", "category": "Prove", "icon": "$(check)" },
      { "command": "prove.verifyCi", "title": "Prove: Verify (CI mode)", "category": "Prove" },
      { "command": "prove.doctor", "title": "Prove: Doctor", "category": "Prove" },
      { "command": "prove.openPolicy", "title": "Prove: Open Policy", "category": "Prove" },
      { "command": "prove.openMission", "title": "Prove: Open Mission", "category": "Prove" },
      { "command": "prove.refresh", "title": "Prove: Refresh", "category": "Prove", "icon": "$(refresh)" },
      { "command": "prove.init", "title": "Prove: Init", "category": "Prove" },
      { "command": "prove.openReceipt", "title": "Prove: Open Receipt Webview", "category": "Prove" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prove",
          "title": "Prove",
          "icon": "media/prove.svg"
        }
      ]
    },
    "views": {
      "prove": [
        {
          "id": "prove.mission",
          "name": "Mission & Evidence",
          "contextualTitle": "Prove"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "prove.refresh",
          "when": "view == prove.mission",
          "group": "navigation@1"
        },
        {
          "command": "prove.verify",
          "when": "view == prove.mission",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        { "command": "prove.openReceipt", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Prove",
      "properties": {
        "prove.cliPath": {
          "type": "string",
          "default": "prove",
          "description": "Path to the prove CLI binary (default: prove on PATH)."
        },
        "prove.autoRefreshMs": {
          "type": "number",
          "default": 3000,
          "minimum": 0,
          "description": "How often to refresh .prove state (ms). 0 disables polling (file watcher still active)."
        }
      }
    }
  },
  "scripts": {
    "compile": "node ./node_modules/typescript/lib/tsc.js -p .",
    "watch": "node ./node_modules/typescript/lib/tsc.js -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "node ./node_modules/typescript/lib/tsc.js -p . && node ../../scripts/package-vsix.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AyanB123/prove.git"
  },
  "bugs": {
    "url": "https://github.com/AyanB123/prove/issues"
  },
  "homepage": "https://github.com/AyanB123/prove#readme",
  "license": "Apache-2.0"
}
